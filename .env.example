# Öffentliche Produktions-URL (Logo-URL in E-Mails, Foto-Links)
NEXT_PUBLIC_SITE_URL=https://blitzeblank.lu

# E-Mail-Versand über Brevo. Die Absenderadresse muss in Brevo verifiziert sein.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Blitzeblank
# Optional: abweichende Logo-URL für E-Mails
EMAIL_LOGO_URL=

# Signierschlüssel für den Conversion-Nachweis (mind. 16 Zeichen, z. B. openssl rand -base64 32)
LEAD_PROOF_SECRET=

ADMIN_PASSWORD=

# MySQL (Mittwald)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Persistentes Volume für Fotos (im Container: /data/uploads)
UPLOAD_DIR=/data/uploads

# Nur für das einmalige Migrationsskript (pnpm migrate:blob)
BLOB_READ_WRITE_TOKEN=
